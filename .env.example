# Pizza Harrison - Environment Configuration

# Public Site Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_RESTAURANT_NAME="Pizza Harrison"
NEXT_PUBLIC_RESTAURANT_CITY="Mathura"
NEXT_PUBLIC_RESTAURANT_PHONE="7451800502"
NEXT_PUBLIC_WHATSAPP_NUMBER="7451800502"
NEXT_PUBLIC_RESTAURANT_EMAIL="order@pizzaharrison.com"

# Supabase Public Keys (Required for remote cloud database)
# Leave blank or unconfigured to automatically use the resilient local/offline data provider
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase Secret Role Key (Server-only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=""

# Payment Gateway (Optional - when configured)
# If empty, the system automatically uses verified Cash on Delivery & UPI QR
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# SMS Gateway Configuration (Optional - for real Indian SMS OTP delivery)
# Supported: Fast2SMS (India DLT) or Twilio
# If left blank, the platform safely runs in Dev/Sandbox OTP mode (codes logged in server terminal)
FAST2SMS_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
